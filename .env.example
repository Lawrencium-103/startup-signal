# Startup Signal Configuration
# Copy to .env and fill in your values.

# --- API Keys (at least one AI key required) ---
OPENAI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_MODEL=moonshotai/kimi-k2.6

# --- Email (Brevo/SendGrid SMTP free tier) ---
SMTP_HOST=smtp-relay.sendinblue.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# --- Enrichment (optional) ---
APOLLO_API_KEY=

# --- Additional Sources (optional) ---
PRODUCTHUNT_API_KEY=
CRUNCHBASE_API_KEY=
